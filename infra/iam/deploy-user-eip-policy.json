{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ElasticIpLifecycle",
      "Effect": "Allow",
      "Action": [
        "ec2:AllocateAddress",
        "ec2:ReleaseAddress",
        "ec2:DescribeAddresses"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AssociateOnlyToTaggedTier2Instance",
      "Effect": "Allow",
      "Action": [
        "ec2:AssociateAddress",
        "ec2:DisassociateAddress"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ec2:*:*:elastic-ip/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Role": "gene-web-tier2"
        }
      }
    }
  ]
}

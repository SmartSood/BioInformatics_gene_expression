{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeIsAccountWideInEC2",
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances"],
      "Resource": "*"
    },
    {
      "Sid": "StopOnlyTheTaggedTier2Instance",
      "Effect": "Allow",
      "Action": ["ec2:StopInstances"],
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Role": "gene-web-tier2"
        }
      }
    }
  ]
}

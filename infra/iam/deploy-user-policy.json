{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EC2InstanceLifecycle",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:TerminateInstances",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:CreateTags",
        "ec2:DescribeImages",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeVolumes"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2NetworkingSetup",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeSecurityGroups",
        "ec2:CreateSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs",
        "ec2:DescribeKeyPairs",
        "ec2:CreateKeyPair"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AttachInstanceProfilesAtLaunch",
      "Effect": "Allow",
      "Action": [
        "ec2:AssociateIamInstanceProfile",
        "ec2:DescribeIamInstanceProfileAssociations"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CreateTheTwoWakeRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePolicy",
        "iam:CreateInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:GetRole",
        "iam:GetInstanceProfile",
        "iam:TagRole"
      ],
      "Resource": [
        "arn:aws:iam::533389119690:role/gene-web-tier1-wake",
        "arn:aws:iam::533389119690:role/gene-web-tier2-self-stop",
        "arn:aws:iam::533389119690:instance-profile/gene-web-tier1-wake",
        "arn:aws:iam::533389119690:instance-profile/gene-web-tier2-self-stop"
      ]
    },
    {
      "Sid": "LetEC2AssumeOnlyTheseTwoRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::533389119690:role/gene-web-tier1-wake",
        "arn:aws:iam::533389119690:role/gene-web-tier2-self-stop"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DatasetBucket",
      "Effect": "Allow",
      "Action": ["s3:CreateBucket", "s3:PutObject", "s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::gene-web-data",
        "arn:aws:s3:::gene-web-data/*"
      ]
    }
  ]
}
